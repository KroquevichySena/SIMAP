# =====================================================================
# SIMAP - variáveis de ambiente
# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o Git.
# Os valores abaixo servem para rodar localmente. Os comentários "Produção"
# indicam o que muda no servidor (Render).
# =====================================================================

# --- Django (obrigatórias) -------------------------------------------
# Gere uma chave com:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-por-uma-chave-secreta
# Produção: False
DEBUG=True
# Produção: o domínio do site, ex.: simap.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost
# Produção: https://simap.onrender.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Produção: True (redireciona http para https)
SECURE_SSL_REDIRECT=False

# --- Banco de dados (obrigatória) ------------------------------------
# Mais simples para avaliar o sistema: SQLite, sem instalar nada
DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL 16 (o banco da monografia e da produção):
# DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/simap
# Opcional: segundos que uma conexão é reaproveitada
# CONN_MAX_AGE=60

# --- Auditoria -------------------------------------------------------
# Dias de guarda dos registros
AUDITORIA_RETENCAO_DIAS=180
# Proxies na frente do Django. Local: 0. Produção (Render): 1
AUDITORIA_PROXIES_CONFIAVEIS=0

# --- Google Gemini (correção das atividades e tutoria) ---------------
# Chave gratuita em https://aistudio.google.com/
# Sem chave, as funções de IA ficam indisponíveis e o resto do sistema funciona
GEMINI_API_KEY=
# Opcional: modelo usado na ajuda ao aluno
# TUTORIA_MODELO=gemini-3.1-flash-lite
# Opcional: False se a chave gratuita não tiver cota para a busca na web
# TUTORIA_BUSCA_NA_WEB=True

# --- E-mail ----------------------------------------------------------
# Local: os e-mails aparecem no terminal do runserver
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Produção: EMAIL_BACKEND=usuarios.email_backend.MailgunEmailBackend
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_API_URL=https://api.mailgun.net
DEFAULT_FROM_EMAIL=nao-responda@simap.local
# Endereço público do SIMAP para links nos e-mails. Local: http://127.0.0.1:8000
# Produção: https://seu-dominio-do-simap
SIMAP_PUBLIC_URL=http://127.0.0.1:8000

# --- Opcionais -------------------------------------------------------
# DJANGO_LOG_LEVEL=INFO
# SIMAP_PYODIDE_URL=https://cdn.jsdelivr.net/npm/pyodide@0.29.5/
